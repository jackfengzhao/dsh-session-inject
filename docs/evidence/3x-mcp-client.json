  "tools": {
    "tools": [
      {
        "name": "sessions_list",
        "description": "List the live DSH sessions: session_id, title, model, cwd, busy.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "name": "session_inject",
        "description": "Deliver a user turn INTO one live DSH session (the session itself executes it: its own model, tools and context - no subagent). wait_ms is capped by maxWaitMs (240000ms); a capped or timed-out wait returns ok:true, status:\"running\", wait_capped and submission_id - never an error. Poll inject_status/submissions_list for the reply.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "Target session id; omitted = first live session."
            },
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32000,
              "description": "Task text delivered as the user turn."
            },
            "delivery": {
              "type": "string",
              "enum": [
                "queue",
                "steer"
              ],
              "default": "queue"
            },
            "wait_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 600000,
              "default": 3000,
              "description": "Requested wait; omitted = 3000ms, 0 = return after admission, capped at maxWaitMs (240000)."
            }
          },
          "required": [
            "content"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "inject_status",
        "description": "Read one submission by id. Adds phase (queued|running|stalled|done|failed|orphaned), last_activity_at, idle_ms, steps_seen, reply_preview, queue_position. An id from a previous dsh process returns phase=\"orphaned\" with the last persisted state.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "submission_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "submission_id"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "submissions_list",
        "description": "List submissions (live + persisted), newest first. Use this to recover a submission when the original call was cut off and its id was lost.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            },
            "status": {
              "type": "string",
              "enum": [
                "queued",
                "running",
                "stalled",
                "done",
                "failed",
                "orphaned"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "session_create",
        "description": "Create a new blank DSH session and return its id. Optional cwd/agentPreset and provider/model (model is pinned with sessionController.selectModel).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "cwd": {
              "type": "string",
              "description": "Working directory for the new session."
            },
            "agentPreset": {
              "type": "string",
              "description": "Agent preset id (default: profile default)."
            },
            "provider": {
              "type": "string",
              "description": "LLM provider id to pin."
            },
            "model": {
              "type": "string",
              "description": "Model id to pin (requires provider)."
            }
          },
          "additionalProperties": false
        }
      }
    ]
  },
